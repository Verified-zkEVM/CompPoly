    y0_11, y0_12, y0_13, y0_14, y0_15]
  let b := splice b i1.toNat #[y1_0, y1_1, y1_2, y1_3, y1_4, y1_5, y1_6, y1_7, y1_8, y1_9, y1_10,
    y1_11, y1_12, y1_13, y1_14, y1_15]
  let b := splice b i2.toNat #[y2_0, y2_1, y2_2, y2_3, y2_4, y2_5, y2_6, y2_7, y2_8, y2_9, y2_10,
