  let y0_9 := fieldAdd a0_9 a1_9
  let y1_9 := fieldMul (readField tl (j) 9 ) (fieldSub a0_9 a1_9)
  let y2_9 := fieldAdd a2_9 a3_9
  let y3_9 := fieldMul (readField tl (j) 9 ) (fieldSub a2_9 a3_9)
  let x0_10 := readField b (i0) 10
  let x1_10 := readField b (i1) 10
  let x2_10 := readField b (i2) 10
  let x3_10 := readField b (i3) 10
  let a0_10 := fieldAdd x0_10 x2_10
  let a1_10 := fieldAdd x1_10 x3_10
  let a2_10 := fieldMul (readField th (j) 10 ) (fieldSub x0_10 x2_10)
  let a3_10 := fieldMul (readField th (j1) 10 ) (fieldSub x1_10 x3_10)
  let y0_10 := fieldAdd a0_10 a1_10
  let y1_10 := fieldMul (readField tl (j) 10 ) (fieldSub a0_10 a1_10)
  let y2_10 := fieldAdd a2_10 a3_10
  let y3_10 := fieldMul (readField tl (j) 10 ) (fieldSub a2_10 a3_10)
  let x0_11 := readField b (i0) 11
  let x1_11 := readField b (i1) 11
  let x2_11 := readField b (i2) 11
  let x3_11 := readField b (i3) 11
  let a0_11 := fieldAdd x0_11 x2_11
  let a1_11 := fieldAdd x1_11 x3_11
  let a2_11 := fieldMul (readField th (j) 11 ) (fieldSub x0_11 x2_11)
  let a3_11 := fieldMul (readField th (j1) 11 ) (fieldSub x1_11 x3_11)
  let y0_11 := fieldAdd a0_11 a1_11
  let y1_11 := fieldMul (readField tl (j) 11 ) (fieldSub a0_11 a1_11)
  let y2_11 := fieldAdd a2_11 a3_11
  let y3_11 := fieldMul (readField tl (j) 11 ) (fieldSub a2_11 a3_11)
  let x0_12 := readField b (i0) 12
  let x1_12 := readField b (i1) 12
  let x2_12 := readField b (i2) 12
  let x3_12 := readField b (i3) 12
  let a0_12 := fieldAdd x0_12 x2_12
  let a1_12 := fieldAdd x1_12 x3_12
  let a2_12 := fieldMul (readField th (j) 12 ) (fieldSub x0_12 x2_12)
  let a3_12 := fieldMul (readField th (j1) 12 ) (fieldSub x1_12 x3_12)
  let y0_12 := fieldAdd a0_12 a1_12
  let y1_12 := fieldMul (readField tl (j) 12 ) (fieldSub a0_12 a1_12)
