  let x3_6 := readField b (i3) 6
  let a0_6 := fieldAdd x0_6 x2_6
  let a1_6 := fieldAdd x1_6 x3_6
  let a2_6 := fieldMul (readField th (j) 6 ) (fieldSub x0_6 x2_6)
  let a3_6 := fieldMul (readField th (j1) 6 ) (fieldSub x1_6 x3_6)
  let y0_6 := fieldAdd a0_6 a1_6
  let y1_6 := fieldMul (readField tl (j) 6 ) (fieldSub a0_6 a1_6)
  let y2_6 := fieldAdd a2_6 a3_6
  let y3_6 := fieldMul (readField tl (j) 6 ) (fieldSub a2_6 a3_6)
  let x0_7 := readField b (i0) 7
  let x1_7 := readField b (i1) 7
  let x2_7 := readField b (i2) 7
  let x3_7 := readField b (i3) 7
  let a0_7 := fieldAdd x0_7 x2_7
  let a1_7 := fieldAdd x1_7 x3_7
  let a2_7 := fieldMul (readField th (j) 7 ) (fieldSub x0_7 x2_7)
  let a3_7 := fieldMul (readField th (j1) 7 ) (fieldSub x1_7 x3_7)
  let y0_7 := fieldAdd a0_7 a1_7
  let y1_7 := fieldMul (readField tl (j) 7 ) (fieldSub a0_7 a1_7)
  let y2_7 := fieldAdd a2_7 a3_7
  let y3_7 := fieldMul (readField tl (j) 7 ) (fieldSub a2_7 a3_7)
  let x0_8 := readField b (i0) 8
  let x1_8 := readField b (i1) 8
  let x2_8 := readField b (i2) 8
  let x3_8 := readField b (i3) 8
  let a0_8 := fieldAdd x0_8 x2_8
  let a1_8 := fieldAdd x1_8 x3_8
  let a2_8 := fieldMul (readField th (j) 8 ) (fieldSub x0_8 x2_8)
  let a3_8 := fieldMul (readField th (j1) 8 ) (fieldSub x1_8 x3_8)
  let y0_8 := fieldAdd a0_8 a1_8
  let y1_8 := fieldMul (readField tl (j) 8 ) (fieldSub a0_8 a1_8)
  let y2_8 := fieldAdd a2_8 a3_8
  let y3_8 := fieldMul (readField tl (j) 8 ) (fieldSub a2_8 a3_8)
  let x0_9 := readField b (i0) 9
  let x1_9 := readField b (i1) 9
  let x2_9 := readField b (i2) 9
  let x3_9 := readField b (i3) 9
  let a0_9 := fieldAdd x0_9 x2_9
  let a1_9 := fieldAdd x1_9 x3_9
