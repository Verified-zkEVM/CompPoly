module

public import CompPoly.Univariate.NTTFast.Packed.FieldStorage

/-! # Field-level models of the packed scalar kernels -/

@[expose] public section
namespace CompPoly.CPolynomial.NTTFast.Packed

/-- Read one coordinate in the field-level kernel model. -/
def readField (a : Array KoalaBear.Fast.Field) (i o : USize) : KoalaBear.Fast.Field :=
  a.getD (i.toNat + o.toNat) 0
/-- Addition in the field-level kernel model. -/
def fieldAdd (x y : KoalaBear.Fast.Field) : KoalaBear.Fast.Field := x + y
/-- Subtraction in the field-level kernel model. -/
def fieldSub (x y : KoalaBear.Fast.Field) : KoalaBear.Fast.Field := x - y
/-- Multiplication in the field-level kernel model. -/
def fieldMul (x y : KoalaBear.Fast.Field) : KoalaBear.Fast.Field := x * y

/-- Sixteen independent radix-four butterflies, with four batched array stores. -/
def step16Field (th tl : Array KoalaBear.Fast.Field) (j j1 i0 i1 i2 i3 : USize)
    (b : Array KoalaBear.Fast.Field) : Array KoalaBear.Fast.Field :=
  let x0_0 := readField b (i0) 0
  let x1_0 := readField b (i1) 0
  let x2_0 := readField b (i2) 0
  let x3_0 := readField b (i3) 0
  let a0_0 := fieldAdd x0_0 x2_0
  let a1_0 := fieldAdd x1_0 x3_0
  let a2_0 := fieldMul (readField th (j) 0 ) (fieldSub x0_0 x2_0)
  let a3_0 := fieldMul (readField th (j1) 0 ) (fieldSub x1_0 x3_0)
  let y0_0 := fieldAdd a0_0 a1_0
  let y1_0 := fieldMul (readField tl (j) 0 ) (fieldSub a0_0 a1_0)
  let y2_0 := fieldAdd a2_0 a3_0
  let y3_0 := fieldMul (readField tl (j) 0 ) (fieldSub a2_0 a3_0)
  let x0_1 := readField b (i0) 1
  let x1_1 := readField b (i1) 1
  let x2_1 := readField b (i2) 1
  let x3_1 := readField b (i3) 1
  let a0_1 := fieldAdd x0_1 x2_1
  let a1_1 := fieldAdd x1_1 x3_1
  let a2_1 := fieldMul (readField th (j) 1 ) (fieldSub x0_1 x2_1)
  let a3_1 := fieldMul (readField th (j1) 1 ) (fieldSub x1_1 x3_1)
  let y0_1 := fieldAdd a0_1 a1_1
  let y1_1 := fieldMul (readField tl (j) 1 ) (fieldSub a0_1 a1_1)
  let y2_1 := fieldAdd a2_1 a3_1
  let y3_1 := fieldMul (readField tl (j) 1 ) (fieldSub a2_1 a3_1)
  let x0_2 := readField b (i0) 2
  let x1_2 := readField b (i1) 2
  let x2_2 := readField b (i2) 2
  let x3_2 := readField b (i3) 2
  let a0_2 := fieldAdd x0_2 x2_2
  let a1_2 := fieldAdd x1_2 x3_2
  let a2_2 := fieldMul (readField th (j) 2 ) (fieldSub x0_2 x2_2)
  let a3_2 := fieldMul (readField th (j1) 2 ) (fieldSub x1_2 x3_2)
  let y0_2 := fieldAdd a0_2 a1_2
  let y1_2 := fieldMul (readField tl (j) 2 ) (fieldSub a0_2 a1_2)
  let y2_2 := fieldAdd a2_2 a3_2
  let y3_2 := fieldMul (readField tl (j) 2 ) (fieldSub a2_2 a3_2)
  let x0_3 := readField b (i0) 3
  let x1_3 := readField b (i1) 3
  let x2_3 := readField b (i2) 3
  let x3_3 := readField b (i3) 3
  let a0_3 := fieldAdd x0_3 x2_3
  let a1_3 := fieldAdd x1_3 x3_3
  let a2_3 := fieldMul (readField th (j) 3 ) (fieldSub x0_3 x2_3)
  let a3_3 := fieldMul (readField th (j1) 3 ) (fieldSub x1_3 x3_3)
  let y0_3 := fieldAdd a0_3 a1_3
  let y1_3 := fieldMul (readField tl (j) 3 ) (fieldSub a0_3 a1_3)
  let y2_3 := fieldAdd a2_3 a3_3
  let y3_3 := fieldMul (readField tl (j) 3 ) (fieldSub a2_3 a3_3)
  let x0_4 := readField b (i0) 4
  let x1_4 := readField b (i1) 4
  let x2_4 := readField b (i2) 4
  let x3_4 := readField b (i3) 4
  let a0_4 := fieldAdd x0_4 x2_4
  let a1_4 := fieldAdd x1_4 x3_4
  let a2_4 := fieldMul (readField th (j) 4 ) (fieldSub x0_4 x2_4)
  let a3_4 := fieldMul (readField th (j1) 4 ) (fieldSub x1_4 x3_4)
  let y0_4 := fieldAdd a0_4 a1_4
  let y1_4 := fieldMul (readField tl (j) 4 ) (fieldSub a0_4 a1_4)
  let y2_4 := fieldAdd a2_4 a3_4
  let y3_4 := fieldMul (readField tl (j) 4 ) (fieldSub a2_4 a3_4)
  let x0_5 := readField b (i0) 5
  let x1_5 := readField b (i1) 5
  let x2_5 := readField b (i2) 5
  let x3_5 := readField b (i3) 5
  let a0_5 := fieldAdd x0_5 x2_5
  let a1_5 := fieldAdd x1_5 x3_5
  let a2_5 := fieldMul (readField th (j) 5 ) (fieldSub x0_5 x2_5)
  let a3_5 := fieldMul (readField th (j1) 5 ) (fieldSub x1_5 x3_5)
  let y0_5 := fieldAdd a0_5 a1_5
  let y1_5 := fieldMul (readField tl (j) 5 ) (fieldSub a0_5 a1_5)
  let y2_5 := fieldAdd a2_5 a3_5
  let y3_5 := fieldMul (readField tl (j) 5 ) (fieldSub a2_5 a3_5)
  let x0_6 := readField b (i0) 6
  let x1_6 := readField b (i1) 6
